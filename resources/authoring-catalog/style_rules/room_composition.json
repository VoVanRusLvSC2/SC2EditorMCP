      "anchor": "security",
      "support": ["console", "equipment", "console"]
    },
    "habitation": {
      "anchor": "bench",
      "support": ["cargo", "bench", "utility", "console"],
      "secondary": { "anchor": "bench", "support": ["cargo"] }
    }
